{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\", namespace=\"microservices-platform\", severity=\"critical\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Critical Alerts",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\", namespace=\"microservices-platform\", severity=\"warning\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Warning Alerts",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(sum(kube_deployment_status_replicas_available{namespace=\"microservices-platform\", deployment!=\"loadgenerator\"}) + sum(kube_statefulset_status_replicas_ready{namespace=\"microservices-platform\"})) / (sum(kube_deployment_spec_replicas{namespace=\"microservices-platform\", deployment!=\"loadgenerator\"}) + sum(kube_statefulset_replicas{namespace=\"microservices-platform\"}))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Workload Availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{namespace=\"microservices-platform\", phase=\"Running\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Running Pods",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "expr": "max by (alertname, namespace, deployment, statefulset, severity) (ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\", namespace=\"microservices-platform\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Active Alerts",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true },
            "indexByName": {
              "alertname": 0,
              "namespace": 1,
              "deployment": 2,
              "statefulset": 3,
              "severity": 4
            },
            "renameByName": {
              "alertname": "Alert",
              "deployment": "Deployment",
              "namespace": "Namespace",
              "severity": "Severity",
              "statefulset": "StatefulSet"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "cores" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 11 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (workload) (max by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=\"microservices-platform\"}[$__rate_interval])) * on (namespace, pod) group_left(workload) max by (namespace, pod, workload) (namespace_workload_pod:kube_pod_owner:relabel{namespace=\"microservices-platform\"}))",
          "legendFormat": "{{workload}}",
          "refId": "A"
        }
      ],
      "title": "CPU by Workload",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 11 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (workload) (max by (namespace, pod) (container_memory_working_set_bytes{namespace=\"microservices-platform\"}) * on (namespace, pod) group_left(workload) max by (namespace, pod, workload) (namespace_workload_pod:kube_pod_owner:relabel{namespace=\"microservices-platform\"}))",
          "legendFormat": "{{workload}}",
          "refId": "A"
        }
      ],
      "title": "Memory by Workload",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 18 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"microservices-platform\"}[$__range]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Pod Restarts",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 18 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"microservices-platform\", horizontalpodautoscaler=\"frontend\"}",
          "legendFormat": "Current",
          "refId": "A"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"microservices-platform\", horizontalpodautoscaler=\"frontend\"}",
          "legendFormat": "Maximum",
          "refId": "B"
        }
      ],
      "title": "Frontend HPA Replicas",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 18 },
      "id": 10,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "expr": "1 - kubelet_volume_stats_available_bytes{namespace=\"microservices-platform\", persistentvolumeclaim=\"redis-data-redis-cart-0\"} / kubelet_volume_stats_capacity_bytes{namespace=\"microservices-platform\", persistentvolumeclaim=\"redis-data-redis-cart-0\"}",
          "instant": true,
          "legendFormat": "Redis data",
          "refId": "A"
        }
      ],
      "title": "Redis PVC Usage",
      "type": "bargauge"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["microservices-platform", "kubernetes"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "label": "Data source",
        "name": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Microservices Platform Overview",
  "uid": "microservices-platform-overview",
  "version": 1
}
